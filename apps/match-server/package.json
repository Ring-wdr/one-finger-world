{
	"name": "@ofa/match-server",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"description": "Standalone match server (Bun): hosts MatchCore rooms over WebSocket outside Cloudflare (docs/match-server-oracle.md).",
	"scripts": {
		"start": "bun src/main.ts",
		"build": "bun build src/main.ts --target=bun --outfile dist/server.js"
	},
	"dependencies": {
		"@ofa/match": "workspace:*",
		"@ofa/meta": "workspace:*",
		"@ofa/net": "workspace:*",
		"@ofa/sim": "workspace:*"
	},
	"devDependencies": {
		"@types/bun": "^1.3.12"
	}
}
