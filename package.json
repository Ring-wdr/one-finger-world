{
	"name": "one-finger-act",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"scripts": {
		"dev": "bun run --cwd apps/client dev",
		"dev:server": "bun run --cwd apps/server dev",
		"dev:online": "bun scripts/dev-online.ts",
		"build": "bun run --cwd apps/client build",
		"deploy": "bun run build && bun run --cwd apps/server deploy",
		"db:migrate:local": "bun run --cwd apps/server db:migrate:local",
		"db:migrate:remote": "bun run --cwd apps/server db:migrate:remote",
		"typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/server/tsconfig.json && tsc --noEmit -p apps/match-server/tsconfig.json && bun run --cwd apps/server types --check",
		"test": "vitest --run",
		"test:unit": "vitest --run --project unit",
		"test:workers": "vitest --run --project workers",
		"balance": "bun packages/sim/scripts/balance.ts",
		"profile": "bun packages/sim/scripts/profile.ts",
		"loadtest": "bun apps/server/scripts/loadtest.ts",
		"multiplayer": "bun apps/server/scripts/multiplayer.ts",
		"assets:characters": "bun apps/client/scripts/build-characters.ts",
		"assets:props": "bun apps/client/scripts/build-props.ts",
		"dev:match": "bun run --cwd apps/match-server start"
	},
	"devDependencies": {
		"@gltf-transform/core": "^4.5.0",
		"@gltf-transform/extensions": "^4.5.0",
		"@gltf-transform/functions": "^4.5.0",
		"@types/node": "^24",
		"meshoptimizer": "^1.2.0",
		"typescript": "^6.0.2",
		"vite": "^8.0.7",
		"vitest": "^4.1.3"
	}
}
